<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>AirMic</AssemblyName>
    <Version>0.2.0</Version>
    <PlatformTarget>x64</PlatformTarget>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../AirMic.Core/AirMic.Core.csproj" />
    <ProjectReference Include="../AirMic.Setup/AirMic.Setup.csproj" />
    <EmbeddedResource Include="$(AirMicDriverPackage)" LogicalName="AirMic.DriverPackage.zip"
                      Condition="'$(AirMicDriverPackage)' != '' and Exists('$(AirMicDriverPackage)')" />
    <EmbeddedResource Include="$(AirMicNoticesPackage)" LogicalName="AirMic.RedistributionNotices.zip"
                      Condition="'$(AirMicNoticesPackage)' != '' and Exists('$(AirMicNoticesPackage)')" />
  </ItemGroup>
  <Target Name="ValidateAirMicBundlePaths" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(AirMicDriverPackage)' != '' and !Exists('$(AirMicDriverPackage)')" Text="AirMicDriverPackage does not exist." />
    <Error Condition="'$(AirMicNoticesPackage)' != '' and !Exists('$(AirMicNoticesPackage)')" Text="AirMicNoticesPackage does not exist." />
  </Target>
</Project>
