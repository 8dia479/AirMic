; AirMic virtual cable. No external APO, service, DLL or third-party audio app.
; Native MS-PL SysVAD subset + MIT AirMic bridge. This source is NOT a signed package.
[Version]
Signature="$Windows NT$"
Class=MEDIA
ClassGUID={4d36e96c-e325-11ce-bfc1-08002be10318}
Provider=%Provider%
DriverVer=11/14/2026,0.2.0.0
CatalogFile=AirMic.cat
PnpLockDown=1

[Manufacturer]
%Provider%=AirMicModels,NTamd64.10.0...19041

[AirMicModels.NTamd64.10.0...19041]
%DeviceDescription%=AirMic,Root\AirMic

[SourceDisksNames]
1=%DiskName%,,,
[SourceDisksFiles]
AirMic.sys=1
[DestinationDirs]
AirMic.CopyFiles=13
[AirMic.CopyFiles]
AirMic.sys

[AirMic.NT]
Include=ks.inf,wdmaudio.inf
Needs=KS.Registration,WDMAUDIO.Registration
CopyFiles=AirMic.CopyFiles
AddReg=AirMic.Device.AddReg

[AirMic.Device.AddReg]
HKR,,AssociatedFilters,,"wdmaud"
HKR,,Driver,,AirMic.sys
HKR,Drivers,SubClasses,,"wave,mixer"
HKR,Drivers\wave\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\wave\wdmaud.drv,Description,,%DeviceDescription%
HKR,Drivers\mixer\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\mixer\wdmaud.drv,Description,,%DeviceDescription%

[AirMic.NT.Services]
AddService=AirMic,0x00000002,AirMic.Service
[AirMic.Service]
DisplayName=%DeviceDescription%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\AirMic.sys

[AirMic.NT.Wdf]
KmdfService=AirMic,AirMic.Wdf
[AirMic.Wdf]
KmdfLibraryVersion=$KMDFVERSION$

[AirMic.NT.HW]
AddReg=AirMic.Hardware.AddReg
[AirMic.Hardware.AddReg]
HKR,,DeviceType,0x00010001,0x0000001D
; Normal Windows audio users may open KS endpoints. There are no custom IOCTLs.
HKR,,Security,,"D:P(A;;GA;;;SY)(A;;GRGWGX;;;BA)(A;;GRGWGX;;;WD)(A;;GRGWGX;;;RC)"

[AirMic.NT.Interfaces]
AddInterface=%KSCATEGORY_AUDIO%,WaveAirMicInput,AirMic.WaveInput
AddInterface=%KSCATEGORY_RENDER%,WaveAirMicInput,AirMic.WaveInput
AddInterface=%KSCATEGORY_REALTIME%,WaveAirMicInput,AirMic.WaveInput
AddInterface=%KSCATEGORY_AUDIO%,TopologyAirMicInput,AirMic.TopologyInput
AddInterface=%KSCATEGORY_TOPOLOGY%,TopologyAirMicInput,AirMic.TopologyInput
AddInterface=%KSCATEGORY_AUDIO%,WaveAirMicMicrophone,AirMic.WaveMicrophone
AddInterface=%KSCATEGORY_CAPTURE%,WaveAirMicMicrophone,AirMic.WaveMicrophone
AddInterface=%KSCATEGORY_REALTIME%,WaveAirMicMicrophone,AirMic.WaveMicrophone
AddInterface=%KSCATEGORY_AUDIO%,TopologyAirMicMicrophone,AirMic.TopologyMicrophone
AddInterface=%KSCATEGORY_TOPOLOGY%,TopologyAirMicMicrophone,AirMic.TopologyMicrophone

[AirMic.WaveInput]
AddReg=AirMic.WaveInput.AddReg
[AirMic.WaveInput.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%InputName%
[AirMic.WaveMicrophone]
AddReg=AirMic.WaveMicrophone.AddReg
[AirMic.WaveMicrophone.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%MicrophoneName%

[AirMic.TopologyInput]
AddReg=AirMic.TopologyInput.AddReg
[AirMic.TopologyInput.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%InputName%
HKR,EP\0,%PKEY_AudioEndpoint_Association%,,%KSNODETYPE_ANY%
HKR,EP\0,%PKEY_AudioEndpoint_Supports_EventDriven_Mode%,0x00010001,1
; Never silently steal the user's default speaker role.
HKR,EP\0,%PKEY_AudioDevice_NeverSetAsDefaultEndpoint%,0x00010001,0x00000105

[AirMic.TopologyMicrophone]
AddReg=AirMic.TopologyMicrophone.AddReg
[AirMic.TopologyMicrophone.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%MicrophoneName%
HKR,EP\0,%PKEY_AudioEndpoint_Association%,,%KSNODETYPE_ANY%
HKR,EP\0,%PKEY_AudioEndpoint_Supports_EventDriven_Mode%,0x00010001,1

[Strings]
Provider="AirMic Project"
DeviceDescription="AirMic Virtual Audio"
DiskName="AirMic Driver Package"
InputName="AirMic Input"
MicrophoneName="AirMic Microphone"
Proxy.CLSID="{17CCA71B-ECD7-11D0-B908-00A0C9223196}"
KSCATEGORY_AUDIO="{6994AD04-93EF-11D0-A3CC-00A0C9223196}"
KSCATEGORY_RENDER="{65E8773E-8F56-11D0-A3B9-00A0C9223196}"
KSCATEGORY_CAPTURE="{65E8773D-8F56-11D0-A3B9-00A0C9223196}"
KSCATEGORY_REALTIME="{EB115FFC-10C8-4964-831D-6DCB02E6F23F}"
KSCATEGORY_TOPOLOGY="{DDA54A40-1E4C-11D1-A050-405705C10000}"
KSNODETYPE_ANY="{00000000-0000-0000-0000-000000000000}"
PKEY_AudioEndpoint_Association="{1DA5D803-D492-4EDD-8C23-E0C0FFEE7F0E},2"
PKEY_AudioEndpoint_Supports_EventDriven_Mode="{1DA5D803-D492-4EDD-8C23-E0C0FFEE7F0E},7"
PKEY_AudioDevice_NeverSetAsDefaultEndpoint="{F3E80BEF-1723-4FF2-BCC4-7F83DC5E46D4},3"
